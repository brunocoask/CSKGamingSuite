    <sys:String x:Key="Live_Cpu">处理器</sys:String>
    <sys:String x:Key="Live_Ram">内存</sys:String>
    <sys:String x:Key="Live_Net">网络</sys:String>
    <sys:String x:Key="Live_Temp">温度</sys:String>

