    <sys:String x:Key="Common_Apply">应用</sys:String>
    <sys:String x:Key="Common_Restore">还原</sys:String>
    <sys:String x:Key="Common_Refresh">刷新</sys:String>
    <sys:String x:Key="Common_Running">正在运行...</sys:String>
    <sys:String x:Key="Common_Success">操作执行成功！</sys:String>
    <sys:String x:Key="Common_Status">状态</sys:String>
    <sys:String x:Key="Common_Active">已启用</sys:String>
    <sys:String x:Key="Common_Inactive">已停用</sys:String>
