<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Header / 系统 -->
    <sys:String x:Key="App_Title">CSK Gaming Suite</sys:String>
    <sys:String x:Key="App_Subtitle">Gaming Suite</sys:String>
    <sys:String x:Key="App_Close">关闭</sys:String>
    <sys:String x:Key="App_Minimize">最小化</sys:String>
